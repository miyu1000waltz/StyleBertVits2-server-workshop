# GPU 版で動かすときは、このファイルを .env にコピーする（コマンドで .env に書き込まない）
#   cp .env.gpu.example .env      （macOS / Linux）
#   copy .env.gpu.example .env    （Windows）
# CPU 版に戻すときは .env を消す
#
# 区切り文字を ; に固定して、Windows・macOS・Linux で同じ内容で動くようにしている
COMPOSE_PATH_SEPARATOR=;
COMPOSE_FILE=docker-compose.yml;docker-compose.gpu.yml
